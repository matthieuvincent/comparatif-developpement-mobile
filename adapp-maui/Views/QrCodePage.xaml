<?xml version="1.0" encoding="utf-8" ?>
<views:BaseContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AD.APP.ViewModels"
    xmlns:views="clr-namespace:AD.APP.Views.Base"
    xmlns:scanner="clr-namespace:BarcodeScanning;assembly=BarcodeScanning.Native.Maui"
    xmlns:resources="clr-namespace:AD.APP.Resources;assembly=AD.APP"
    x:TypeArguments="vm:QrCodeViewModel"
    x:Class="AD.APP.Views.QrCodePage"
    Title="{Binding Title}"
    IconImageSource="{Binding Icon}">
    <ScrollView>
        <VerticalStackLayout
            Padding="20,40"
            Spacing="15">

            <Label Text="{Binding Title}" FontSize="20" FontAttributes="Bold"
                   SemanticProperties.Description="{Binding Title}"
                   SemanticProperties.HeadingLevel="Level1" />

            <scanner:CameraView
                x:Name="Camera"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                HeightRequest="300"
                WidthRequest="300"
                BarcodeSymbologies="QRCode"
                OnDetectionFinished="CameraView_OnDetectionFinished"
                SemanticProperties.Description="{x:Static resources:Labels.cameraView_accessibility}"
                SemanticProperties.HeadingLevel="Level2" />
        </VerticalStackLayout>
    </ScrollView>
</views:BaseContentPage>
