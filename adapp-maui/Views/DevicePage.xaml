<?xml version="1.0" encoding="utf-8" ?>
<views:BaseContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AD.APP.ViewModels"
    xmlns:views="clr-namespace:AD.APP.Views.Base"
	xmlns:resources="clr-namespace:AD.APP.Resources;assembly=AD.APP"
    x:TypeArguments="vm:DeviceViewModel"
    x:Class="AD.APP.Views.DevicePage"
	Title="{Binding Title}"
	IconImageSource="{Binding Icon}">
    
    <ScrollView>
        <VerticalStackLayout
            Padding="20,40"
            Spacing="15">

			<Label 
				Text="{Binding Title}" 
				FontSize="20" 
                FontAttributes="Bold"
                SemanticProperties.Description="{Binding Title}"
				SemanticProperties.HeadingLevel="Level1" />
			
			<Frame
                BorderColor="LightGray"
                CornerRadius="10"
                Padding="15"
                HasShadow="True">
				<VerticalStackLayout Spacing="10">
                    <Label Text="{x:Static resources:Labels.deviceInfoSection}" FontSize="15" FontAttributes="Bold" 
						   SemanticProperties.Description="{x:Static resources:Labels.deviceInfoSection}"
						   SemanticProperties.HeadingLevel="Level2" />
                    <Label Text="{Binding DeviceName, StringFormat={x:Static resources:Labels.deviceName}}" 
						   SemanticProperties.Description="{Binding DeviceName, StringFormat={x:Static resources:Labels.deviceName}}"
						   SemanticProperties.HeadingLevel="Level3" />
                    <Label Text="{Binding Manufacturer, StringFormat={x:Static resources:Labels.manufacturer}}" 
						   SemanticProperties.Description="{Binding Manufacturer, StringFormat={x:Static resources:Labels.manufacturer}}"
						   SemanticProperties.HeadingLevel="Level3" />
                    <Label Text="{Binding Model, StringFormat={x:Static resources:Labels.model}}" 
						   SemanticProperties.Description="{Binding Model, StringFormat={x:Static resources:Labels.model}}"
						   SemanticProperties.HeadingLevel="Level3" />
                    <Label Text="{Binding Version, StringFormat={x:Static resources:Labels.osVersion}}" 
						   SemanticProperties.Description="{Binding Version, StringFormat={x:Static resources:Labels.osVersion}}"
						   SemanticProperties.HeadingLevel="Level3" />
				</VerticalStackLayout>
			</Frame>

			<Frame
                BorderColor="LightGray"
                CornerRadius="10"
                Padding="15"
                HasShadow="True">
				<VerticalStackLayout Spacing="10">
					<Label Text="{x:Static resources:Labels.liveMetricsSection}" FontSize="15" FontAttributes="Bold" 
						   SemanticProperties.Description="{x:Static resources:Labels.liveMetricsSection}" 
						   SemanticProperties.HeadingLevel="Level2" />
					<Label Text="{Binding AccelerometerX, StringFormat={x:Static resources:Labels.accelerometerX}}" 
						   SemanticProperties.Description="{Binding AccelerometerX, StringFormat={x:Static resources:Labels.accelerometerX}}"
						   SemanticProperties.HeadingLevel="Level3" />
					<Label Text="{Binding AccelerometerY, StringFormat={x:Static resources:Labels.accelerometerY}}" 
						   SemanticProperties.Description="{Binding AccelerometerY, StringFormat={x:Static resources:Labels.accelerometerY}}"
						   SemanticProperties.HeadingLevel="Level3" />
					<Label Text="{Binding AccelerometerZ, StringFormat={x:Static resources:Labels.accelerometerZ}}" Margin="0,0,0,10" 
						   SemanticProperties.Description="{Binding AccelerometerZ, StringFormat={x:Static resources:Labels.accelerometerZ}}"
						   SemanticProperties.HeadingLevel="Level3" />
					<Label Text="{Binding Latitude, StringFormat={x:Static resources:Labels.latitude}}" 
						   SemanticProperties.Description="{Binding Latitude, StringFormat={x:Static resources:Labels.latitude}}"
						   SemanticProperties.HeadingLevel="Level3" />
					<Label Text="{Binding Longitude, StringFormat={x:Static resources:Labels.longitude}}" 
						   SemanticProperties.Description="{Binding Longitude, StringFormat={x:Static resources:Labels.longitude}}"
						   SemanticProperties.HeadingLevel="Level3" />
					<Label Text="{Binding Altitude, StringFormat={x:Static resources:Labels.altitude}}" Margin="0,0,0,10" 
						   SemanticProperties.Description="{Binding Altitude, StringFormat={x:Static resources:Labels.altitude_accessibility}}"
						   SemanticProperties.HeadingLevel="Level3" />
					<Label Text="{Binding BatteryLevel, StringFormat={x:Static resources:Labels.batteryLevel}}" 
						   SemanticProperties.Description="{Binding BatteryLevel, StringFormat={x:Static resources:Labels.batteryLevel_accessibility}}"
						   SemanticProperties.HeadingLevel="Level3" />
				</VerticalStackLayout>
			</Frame>
        </VerticalStackLayout>
    </ScrollView>
</views:BaseContentPage>
